# Copie este arquivo para ".env" (no seu PC) OU cadastre cada linha como
# "Secret" no GitHub (Settings > Secrets and variables > Actions).
# NUNCA coloque os valores reais neste arquivo de exemplo.

# --- IA de texto (pelo menos UMA é obrigatória na nuvem) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434   (só no seu PC)

# --- Voz (Google Cloud Text-to-Speech) ---
GOOGLE_TTS_API_KEY=
# Voz Microsoft Azure (plano grátis F0): chave e região do recurso "Speech"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# --- Imagens e vídeos de banco (grátis) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Ilustrações próprias (Cloudflare Workers AI, grátis) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Telegram (aprovação e alertas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (um conjunto por página; sufixo = nome da pasta da página em MAIÚSCULAS, "-" vira "_") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_ENERGIA_EM_CASA=

# --- Meta (Instagram + Página do Facebook) ---
META_PAGE_TOKEN_ENERGIA_EM_CASA=
FB_PAGE_ID_ENERGIA_EM_CASA=
IG_USER_ID_ENERGIA_EM_CASA=
META_GRAPH_VERSION=v23.0
